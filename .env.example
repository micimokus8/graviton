# Kraken Futures API Keys (Perpetuals)
# Erstelle hier: https://www.kraken.com/u/security/api
# Permission: "Futures Trading" (nicht Spot!)
KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_api_secret_here

# Trading
EQUITY_USD=200

# Optional LLM Shadow-Bias (observation only; does not authorize/block trades)
# OpenRouter uses the OpenAI-compatible endpoint below.
LLM_BIAS_ENABLED=false
LLM_BIAS_API_KEY=your_openrouter_key_here
LLM_BIAS_BASE_URL=https://openrouter.ai/api/v1
LLM_BIAS_MODEL=your_openrouter_model_here
LLM_BIAS_MIN_CONFIDENCE=0.65